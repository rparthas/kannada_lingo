# Copy to .env and fill after Xcode + Apple ID setup (Settings → Accounts in Xcode).
# Team ID: developer.apple.com → Membership, or `security find-identity -v -p codesigning`
APPLE_DEVELOPMENT_TEAM=

# Fish (per session): set -x APPLE_DEVELOPMENT_TEAM XXXXXXXXXX
# bash/zsh: export APPLE_DEVELOPMENT_TEAM=XXXXXXXXXX