      "literal_translation": "Greetings / salutation",
      "context_note": "Safe default when meeting shop staff, neighbours, or service workers.",
      "register": "neutral",
      "tags": ["greeting", "home"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
