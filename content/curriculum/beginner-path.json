  "learning_items": [
    {
      "id": "item-namaskara",
      "kannada_text": "ನಮಸ್ಕಾರ",
      "transliteration": "namaskāra",
      "english_meaning": "Hello (formal greeting)",
      "literal_translation": "Greetings / salutation",
      "context_note": "Safe default when meeting shop staff, neighbours, or service workers.",
      "register": "neutral",
      "tags": ["greeting", "home"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
      "id": "item-hengidira",
      "kannada_text": "ಹೇಗಿದ್ದೀರಾ?",
      "transliteration": "hēgiddīrā?",
      "english_meaning": "How are you? (respectful)",
      "context_note": "Use with elders or people you want to be polite with.",
      "register": "formal",
      "tags": ["greeting"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
      "id": "item-chennagi-idini",
      "kannada_text": "ಚೆನ್ನಾಗಿ ಇದ್ದೀನಿ",
      "transliteration": "cennāgi iddīni",
      "english_meaning": "I am fine",
      "context_note": "Common reply to 'How are you?'",
      "register": "informal",
      "tags": ["greeting", "response"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
      "id": "item-dhanyavada",
      "kannada_text": "ಧನ್ಯವಾದ",
      "transliteration": "dhanyavāda",
      "english_meaning": "Thank you",
      "context_note": "Works in shops, restaurants, and with auto drivers.",
      "register": "neutral",
      "tags": ["politeness"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
      "id": "item-sari",
      "kannada_text": "ಸರಿ",
      "transliteration": "sari",
      "english_meaning": "Okay / all right",
      "accepted_answers": ["okay", "ok", "alright"],
      "register": "informal",
      "tags": ["response"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
      "id": "item-illa",
      "kannada_text": "ಇಲ್ಲ",
      "transliteration": "illa",
      "english_meaning": "No",
      "context_note": "General negation — 'no / not / don't have'.",
      "register": "informal",
      "tags": ["response"],
      "difficulty": 1,
      "validation_status": "approved"
    },
    {
      "id": "item-auto-bidu",
      "kannada_text": "ಆಟೋ ಬಿಡಿ",
      "transliteration": "āṭō biḍi",
      "english_meaning": "Stop the auto here",
      "literal_translation": "Auto, leave (stop)",
      "context_note": "Say clearly when you want the driver to stop.",
      "register": "informal",
      "tags": ["auto", "transport"],
      "difficulty": 2,
      "validation_status": "approved"
    },
    {
      "id": "item-elli-hogbeku",
      "kannada_text": "ಎಲ್ಲಿಗೆ ಹೋಗಬೇಕು?",
      "transliteration": "ellige hōgabēku?",
      "english_meaning": "Where do you need to go?",
      "context_note": "Driver may ask you this — know how to answer with a place name.",
      "register": "informal",
      "tags": ["auto", "question"],
      "difficulty": 2,
      "validation_status": "approved"
    },
    {
      "id": "item-meter-prati",
      "kannada_text": "ಮೀಟರ್ ಪ್ರಕಾರ",
      "transliteration": "mīṭar prakāra",
      "english_meaning": "By the meter (fare)",
      "context_note": "Ask to use the meter instead of a flat quote.",
      "register": "informal",
      "tags": ["auto", "fare"],
      "difficulty": 2,
      "validation_status": "approved"
    },
    {
      "id": "item-aidu-nimisha",
      "kannada_text": "ಐದು ನಿಮಿಷ ಬೇಕು",
      "transliteration": "aidu nimisha bēku",
      "english_meaning": "Five minutes, please",
      "context_note": "Useful when asking someone to wait briefly.",
      "register": "informal",
      "tags": ["time"],
      "difficulty": 2,
      "validation_status": "approved"
    }
  ],
