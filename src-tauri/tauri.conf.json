{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kannada Quest",
  "version": "0.1.0",
  "identifier": "com.kannadaquest.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Kannada Quest",
        "width": 390,
        "height": 844,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../content/curriculum/": "content/curriculum/",
      "../content/audio/": "content/audio/"
    },
    "iOS": {
      "developmentTeam": "XR2SACTR43"
    }
  }
}